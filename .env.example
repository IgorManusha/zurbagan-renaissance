# ========================================================================
# Environment variables for the Zurbagan website
# ------------------------------------------------------------------------
# Copy this file to `.env` and fill in values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# All variables prefixed with VITE_ are exposed to the browser bundle.
# That is fine for the publishable (anon) key — it is designed to be public
# and is protected by Row-Level Security policies in the database.
# Never put the SERVICE_ROLE key here or anywhere in the client code.
# ========================================================================

# Public Supabase URL of your project, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable (anon) key from Supabase → Settings → API
VITE_SUPABASE_PUBLISHABLE_KEY=

# Project ID (the "ref" in the Supabase URL)
VITE_SUPABASE_PROJECT_ID=

# Server-side mirrors (used by SSR build). Same values as above.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
